# Yojana Hunter Backend Configuration Example
PROJECT_NAME="Yojana Hunter"
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1

# PostgreSQL Database Connection URL (PostgreSQL 18)
DATABASE_URL=postgresql+psycopg://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/yojana_hunter

# Secrets
SECRET_KEY=your-secret-key-placeholder
JWT_SECRET=your-jwt-secret-placeholder

# Frontend URL (for password reset redirects and CORS)
FRONTEND_URL=http://localhost:3000

# Optional Email Service (SMTP) for Password Reset Emails
# If not configured, password reset tokens are logged to application logs in development mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@yojanahunter.gov.in
